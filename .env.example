# 이 파일을 .env로 복사해서 쓴다. .env는 .gitignore 대상이다.
#
# JWT_SECRET은 반드시 Base64로 인코딩된 값이어야 한다.
# TokenProvider가 Base64.decode(secret)로 HMAC 키를 만들기 때문에,
# 평문을 넣으면 컨텍스트 로딩 단계에서 기동이 실패한다.
#   openssl rand -base64 48
JWT_SECRET=

# 결제(토스) 연동을 쓰지 않으면 둘 다 비워둬도 된다.
#
# 반드시 같은 상점의 "결제창"(test_sk_ / test_ck_) 한 쌍이어야 한다. 위젯 계열(test_gsk_ /
# test_gck_)을 섞으면 결제창은 열리고 승인 단계에서 실패한다 — 코드는 payment.requestPayment,
# 즉 결제창 플로우다(frontend/src/features/payment/toss.ts).
TOSS_SECRET_KEY=
# 클라이언트 키는 공개값이다. compose가 frontend 이미지의 빌드 인자
# (VITE_TOSS_CLIENT_KEY)로 넘긴다. compose를 안 쓰고 npm run dev로 띄운다면
# frontend/.env.local에 VITE_TOSS_CLIENT_KEY=... 로 따로 넣어야 한다.
TOSS_CLIENT_KEY=

# 식약처 화장품 성분/사용제한 공공데이터 API 인증키(data.go.kr 일반 인증키).
# 성분 플래그 시드 재생성 시에만 필요: python3 tools/ingredient_pipeline/build_flag_seed.py
COS_INFO=
